# Optional: override deployed BTC benchmark (defaults to team deployment on 0G)
# NEXT_PUBLIC_BTC_BENCHMARK_ADDRESS=0xd7259ba74751f09c810de52d921e248af1fb7fae

# Which app competition id uses the onchain contract (default: comp_btc_001)
# NEXT_PUBLIC_BTC_COMPETITION_ID=comp_btc_001

# Round id passed to submitResponse / showLeaderboard (default: 0)
# NEXT_PUBLIC_BTC_BENCHMARK_ROUND_ID=0

# Set to empty string to force mock-only (no contract calls):
# NEXT_PUBLIC_BTC_BENCHMARK_ADDRESS=
